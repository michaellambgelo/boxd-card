{
  "name": "boxd-card",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run typecheck && vite build",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "npm run typecheck && vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "generate:preview": "node scripts/generate-social-preview.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.4.0",
    "@grafana/faro-web-tracing": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@crxjs/vite-plugin": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@grafana/faro-rollup-plugin": "^0.10.0",
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "canvas": "^3.2.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  }
}

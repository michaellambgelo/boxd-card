{
  // Build tooling runs in Node, not the browser: separate config so the app
  // sources don't pick up Node globals (setTimeout returning NodeJS.Timeout
  // being the classic way that leaks).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vite.web.config.ts", "vitest.config.ts"]
}
